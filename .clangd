# IDE-only config for clangd. This does not affect the Emscripten build.
# clangd reads compile_commands.json, then this translates the few em++ driver
# flags that clangd's parser cannot understand.
#
# `monero-wasm-src/build.sh` creates a workspace-root symlink
#   compile_commands.json -> monero-wasm-src/built-wasm-<BuildType>/compile_commands.json
# after each successful build, so clangd's default upward-search picks up the
# database that matches the most recently compiled build type.
CompileFlags:
  Add:
    - -pthread
  Remove:
    - -sUSE_PTHREADS=*
    - -sNO_DISABLE_EXCEPTION_CATCHING
