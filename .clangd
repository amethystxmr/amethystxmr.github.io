# IDE-only config for clangd. This does not affect the Emscripten build.
# clangd reads compile_commands.json, then this translates the few em++ driver
# flags that clangd's parser cannot understand.
#
# CompilationDatabase: CMake writes compile_commands.json to
# monero-wasm-src/built-wasm-<BuildType>/, which is not one of clangd's default
# search locations (build/, out/, ...). Pointing it explicitly is what makes
# Go-to-Definition work for files like wasm_wallet_api.cpp. Switch the suffix
# to -Debug if you build with `./build.sh Debug`.
CompileFlags:
  CompilationDatabase: monero-wasm-src/built-wasm-Release
  Add:
    - -pthread
  Remove:
    - -sUSE_PTHREADS=*
    - -sNO_DISABLE_EXCEPTION_CATCHING
