  "version": "0.2.0",
  "configurations": [
    {
      "name": "C/C++: debug project",
      "type": "cppdbg",
      "request": "launch",
      // TODO Change the path
      "program": "${workspaceFolder}/monero-wasm-src/monero/build/debug/bin/monero-wallet-cli",
      "stopAtEntry": false,
      "cwd": ".",
      "environment": [],
      "externalConsole": false,
      "MIMode": "gdb",
      "miDebuggerPath": "/usr/bin/gdb",
      // "preLaunchTask": "MyPreLaunchTask",
      "setupCommands": [
        {
          "description": "Disable element truncation for GDB printing",
          "text": "set print elements 0",
          "ignoreFailures": true
        }
      ]
    }
  ]
}
